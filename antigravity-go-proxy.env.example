# Required local-only API authentication for /v1/* routes.
ANTIGRAVITY_PROXY_API_KEY=replace-with-a-local-secret

# Optional overrides. Refresh credentials are read from the installed agy
# executable when needed; no OAuth client values belong in this file.
# ACCOUNT_STRATEGY=hybrid
# AGY_PROJECT_ID=
# AGY_TOKEN_WRITEBACK=0
# AGY_TOKEN_PATH=
# AGY_BINARY_PATH=

# When every account is out of capacity, Claude Code's own bash-action
# security-monitor calls hang through the normal retry/backoff instead of
# failing fast, stalling the whole session. Set to 1/true/yes to answer
# those specific calls with a canned "allow" verdict instantly instead of
# retrying. Off by default: this skips the classifier's real injection/
# scope-creep checks while capacity is exhausted. See
# docs/classifier-fallback-notes.md for exactly which requests this affects.
# ANTIGRAVITY_PROXY_CLASSIFIER_FALLBACK=1

