      "css": ".ds-track{--fill:0%;--cell:var(--sb-lamp-clear,#fbf6dc);position:relative;display:block;width:100%;min-width:48px;height:8px;box-sizing:content-box;background:var(--sb-track-empty,#3a3b36);border:1.5px solid var(--sb-track,#1b1c19);border-radius:1px;overflow:hidden;}.ds-track::before{content:\"\";position:absolute;inset:0;background:var(--cell);clip-path:inset(0 calc(100% - var(--fill)) 0 0);transition:clip-path 400ms cubic-bezier(.16,1,.3,1),background-color 160ms cubic-bezier(.16,1,.3,1);}.ds-track::after{content:\"\";position:absolute;inset:0;pointer-events:none;background:repeating-linear-gradient(to right,transparent 0,transparent calc(5% - 1.5px),var(--sb-track,#1b1c19) calc(5% - 1.5px),var(--sb-track,#1b1c19) 5%);}.ds-track[data-level=\"caution\"]{--cell:var(--sb-lamp-caution,#e8a20f);}.ds-track[data-level=\"danger\"]{--cell:var(--sb-lamp-danger,#d0371f);}.ds-track[data-level=\"danger\"][data-empty=\"true\"]{background:var(--sb-lamp-danger,#d0371f);}"
    },
    {
      "name": "Lever",
