      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:36px;padding:0 14px;border:1.5px solid var(--sb-ink,#1b1c19);border-radius:var(--sb-radius,2px);background:var(--sb-panel,#f1f1ea);color:var(--sb-ink,#1b1c19);font:600 13px/1 Barlow,system-ui,sans-serif;letter-spacing:.01em;cursor:pointer;transition:background-color 160ms cubic-bezier(.16,1,.3,1),color 160ms cubic-bezier(.16,1,.3,1),border-color 160ms cubic-bezier(.16,1,.3,1);}.ds-btn:focus-visible{outline:2px solid var(--sb-focus,#e8a20f);outline-offset:2px;box-shadow:0 0 0 4px var(--sb-ink,#1b1c19);}.ds-btn:hover{background:var(--sb-sunk,#d6d7ce);border-color:var(--sb-ink,#1b1c19);}.ds-btn:active{background:var(--sb-sunk-2,#cbccc2);}"
