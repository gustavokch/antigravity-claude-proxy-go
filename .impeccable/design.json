      "refersTo": null,
      "description": "Numbered navigation lever. The pulled lever is the current view.",
      "html": "<button type=\"button\" class=\"ds-lever\" aria-current=\"page\"><span class=\"ds-lever-handle\" aria-hidden=\"true\"></span><span class=\"ds-lever-no\">1</span><span class=\"ds-lever-label\">Dashboard</span></button>",
      "css": ".ds-lever{position:relative;display:flex;align-items:center;gap:12px;width:100%;min-height:44px;padding:0 16px;border:0;background:transparent;color:var(--sb-ink-2,#3f413a);font:600 15px/1.2 Barlow,system-ui,sans-serif;text-align:left;cursor:pointer;transition:background-color 160ms cubic-bezier(.16,1,.3,1),color 160ms cubic-bezier(.16,1,.3,1);}.ds-lever:hover{background:var(--sb-sunk-2,#cbccc2);color:var(--sb-ink,#1b1c19);}.ds-lever:focus-visible{outline:2px solid var(--sb-focus,#e8a20f);outline-offset:2px;}.ds-lever-handle{position:relative;flex:none;width:10px;height:24px;}.ds-lever-handle::before{content:\"\";position:absolute;left:3.5px;bottom:2px;width:3px;height:18px;background:var(--sb-ink-3,#52544b);border-radius:1px 1px 0 0;transform-origin:50% 100%;transform:rotate(-22deg);transition:transform 160ms cubic-bezier(.16,1,.3,1);}.ds-lever-handle::after{content:\"\";position:absolute;left:0;right:0;bottom:0;height:3px;background:var(--sb-ink-3,#52544b);}.ds-lever[aria-current=\"page\"] .ds-lever-handle::before,.ds-lever[aria-current=\"page\"] .ds-lever-handle::after{background:var(--sb-ink,#1b1c19);}.ds-lever[aria-current=\"page\"] .ds-lever-handle::before{transform:rotate(22deg);}.ds-lever-no{display:inline-flex;align-items:center;justify-content:center;width:24px;height:22px;border-radius:var(--sb-radius,2px);box-shadow:inset 0 0 0 1px var(--sb-ink-3,#52544b);color:var(--sb-ink-2,#3f413a);font:700 13px/1 \"Barlow Semi Condensed\",Barlow,sans-serif;}.ds-lever[aria-current=\"page\"]{background:var(--sb-panel,#f1f1ea);color:var(--sb-ink,#1b1c19);}.ds-lever[aria-current=\"page\"] .ds-lever-no{background:var(--sb-plate,#1b1c19);color:var(--sb-plate-ink,#f1f1ea);box-shadow:none;}"
    },
    {
      "name": "Route Node",
      "kind": "nav",
