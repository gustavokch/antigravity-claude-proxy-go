      "css": ".ds-field{display:flex;flex-direction:column;gap:6px;}.ds-field-label{font:600 13px/1.2 Barlow,system-ui,sans-serif;color:var(--sb-ink,#1b1c19);}.ds-input{box-sizing:border-box;height:36px;padding:0 10px;border:1px solid var(--sb-rule-strong,#8d8f85);border-radius:var(--sb-radius,2px);background:var(--sb-panel,#f1f1ea);color:var(--sb-ink,#1b1c19);font:400 15px/1.3 Barlow,system-ui,sans-serif;transition:border-color 160ms cubic-bezier(.16,1,.3,1);}.ds-input::placeholder{color:var(--sb-ink-3,#52544b);opacity:1;}.ds-input:hover{border-color:var(--sb-ink-3,#52544b);}.ds-input:focus{outline:2px solid var(--sb-focus,#e8a20f);outline-offset:0;border-color:var(--sb-ink,#1b1c19);}"
